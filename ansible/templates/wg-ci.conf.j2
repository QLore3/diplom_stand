[Interface]
Address = {{ delivery_server_ip }}/32
ListenPort = {{ delivery_port }}
PrivateKey = {{ delivery_server_private.content | b64decode | trim }}
# The tunnel can reach only the local Kubernetes API; no SSH or VPC routing.
PostUp = iptables -I INPUT 1 -i %i -s {{ delivery_client_ip }}/32 -p tcp --dport {{ delivery_api_port }} -j ACCEPT
PostUp = iptables -I INPUT 2 -i %i -j DROP
PostUp = iptables -I FORWARD 1 -i %i -j DROP
PostDown = iptables -D INPUT -i %i -s {{ delivery_client_ip }}/32 -p tcp --dport {{ delivery_api_port }} -j ACCEPT
PostDown = iptables -D INPUT -i %i -j DROP
PostDown = iptables -D FORWARD -i %i -j DROP

[Peer]
PublicKey = {{ delivery_client_public.stdout | trim }}
AllowedIPs = {{ delivery_client_ip }}/32
