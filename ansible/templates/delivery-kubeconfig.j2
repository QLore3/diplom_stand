apiVersion: v1
kind: Config
clusters:
  - name: diplom-delivery
    cluster:
      server: https://{{ delivery_server_ip }}:{{ delivery_api_port }}
      tls-server-name: {{ node_ip }}
      certificate-authority-data: {{ delivery_ca.content }}
users:
  - name: {{ delivery_user }}
    user:
      client-certificate-data: {{ delivery_certificate.content }}
      client-key-data: {{ delivery_client_key.content }}
contexts:
  - name: delivery
    context:
      cluster: diplom-delivery
      user: {{ delivery_user }}
      namespace: {{ delivery_namespace }}
current-context: delivery
